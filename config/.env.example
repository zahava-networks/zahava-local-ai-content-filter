# Copy to .env and fill in.
# === REQUIRED ===

# HuggingFace (storage backend: images + labels + model artifacts)
HF_TOKEN=
HF_DATASET_REPO=zahava-networks/tzniut-data
HF_MODEL_REPO=zahava-networks/tzniut-classifier

# NVIDIA NIM (VLM image labeler)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-90b-vision-instruct

# === OPTIONAL ===
# Each of these unlocks an additional capability if added later.
# Leave blank to skip — the pipeline degrades gracefully.

# Gemini: adds a secondary labeler that handles NIM safety refusals
# instead of routing them straight to human review.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Unsplash/Pexels: add modern-fashion search-based image collection.
# Without these, collection draws from Open Images, DeepFashion2, Fashionpedia,
# ModaNet, and Wikimedia Commons only.
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# Backup compute (free GPU when Colab is unavailable):
# https://www.kaggle.com/settings → API → Create New Token
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# LIGHTNING_USER_KEY=
# LIGHTNING_USER_ID=
