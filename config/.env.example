# Copy to .env and fill in.

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tzniut-images
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# HuggingFace
HF_TOKEN=
HF_DATASET_REPO=your-username/tzniut-labels
HF_MODEL_REPO=your-username/tzniut-classifier

# NVIDIA NIM (build.nvidia.com)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-90b-vision-instruct

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Drive (OAuth for review UI; service account for Colab)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DRIVE_FOLDER_ID=

# Image source APIs
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional: Lightning AI / Kaggle (for backup training compute)
LIGHTNING_USER_KEY=
LIGHTNING_USER_ID=
KAGGLE_USERNAME=
KAGGLE_KEY=
